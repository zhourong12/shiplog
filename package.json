{
  "name": "shiplog",
  "version": "0.2.0",
  "private": true,
  "description": "ShipLog（码上说）：把每天的 git 提交自动写成开发日记和多平台 build-in-public 草稿",
  "type": "module",
  "engines": {
    "node": ">=22.13 <25"
  },
  "bin": {
    "shiplog": "./dist-server/shiplog.js"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "cli": "tsx src/cli/shiplog.ts",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/server/index.ts --outDir dist-server && vite build --ssr src/cli/shiplog.ts --outDir dist-server --emptyOutDir false",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.0",
    "vitest": "^4.0.0"
  }
}
