# ShipLog 本地配置示例。复制为 .env 后按需填写；不要把真实密钥提交到 Git。

# 服务端口
PORT=8792

# Claude API Key。留空时 ShipLog 只生成规范更新日志和数据卡（“未使用 AI”模式）。
ANTHROPIC_API_KEY=
# 可选：模型与思考力度（默认 claude-opus-5-5 / medium）
SHIPLOG_MODEL=claude-opus-5-5
SHIPLOG_EFFORT=medium

# 用于加密 GitHub 令牌的密钥，至少 24 位随机字符；与数据库备份分开保存。
SHIPLOG_ENCRYPTION_KEY=

# 可选：设置后所有 /api 请求（健康检查除外）都需要 Authorization: Bearer <令牌>
SHIPLOG_APP_TOKEN=

# 允许读取的本地仓库根目录（逗号分隔）。生产环境未配置时禁用本地仓库。
SHIPLOG_LOCAL_ROOTS=

# 套餐：free（1 个仓库、每月 10 次 AI 生成、无风格学习）或 pro
SHIPLOG_PLAN=free

# SQLite 数据库位置
SHIPLOG_DB_PATH=var/shiplog.db

# GitHub API 地址（GitHub Enterprise 可改）
GITHUB_API_BASE_URL=https://api.github.com
