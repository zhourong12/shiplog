# ShipLog configuration. Copy to .env and fill in what you need; never commit real secrets.
# ShipLog 配置示例。复制为 .env 后按需填写；不要把真实密钥提交到 Git。

# ---- Server ----
PORT=8792
HOST=127.0.0.1
# 用户访问的地址：GitHub 登录回调、付款跳转和邮件里的链接都用它。生产环境请填 https 地址。
PUBLIC_BASE_URL=http://127.0.0.1:8792
SHIPLOG_DB_PATH=var/shiplog.db
# 加密 GitHub 令牌的密钥，至少 24 位随机字符，与数据库备份分开保存。生产环境必填。
SHIPLOG_ENCRYPTION_KEY=

# ---- AI ----
# 不填时只生成更新日志和数据卡（“未使用 AI”模式）。
ANTHROPIC_API_KEY=
SHIPLOG_MODEL=claude-opus-5-5
SHIPLOG_EFFORT=medium

# ---- 自用模式（不配置 GitHub 登录时）----
# 设置后所有 /api 请求（健康检查除外）都需要 Authorization: Bearer <令牌>
SHIPLOG_APP_TOKEN=
# 允许读取的本地仓库根目录（逗号分隔）。生产环境未配置时禁用本地仓库。
SHIPLOG_LOCAL_ROOTS=
# free（1 个仓库、每月 10 次 AI 生成）或 pro
SHIPLOG_PLAN=free

# ---- 多用户模式：GitHub 登录 ----
# 填写后启用 GitHub 登录与多用户；本地仓库会自动关闭。
# GitHub → Settings → Developer settings → OAuth Apps，回调地址填 ${PUBLIC_BASE_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_API_BASE_URL=https://api.github.com

# ---- 付款（Stripe，仅多用户模式）----
STRIPE_SECRET_KEY=
# Pro 订阅的价格 ID（price_…）
STRIPE_PRICE_ID=
# Webhook 端点：${PUBLIC_BASE_URL}/api/billing/webhook
# 事件：checkout.session.completed、customer.subscription.created/updated/deleted
STRIPE_WEBHOOK_SECRET=

# ---- 每日定时生成与提醒 ----
# 设为 off 可关闭内置定时任务
SHIPLOG_SCHEDULER=on
# 邮件提醒（可选），例如 smtps://user:pass@smtp.example.com:465
SMTP_URL=
SMTP_FROM=ShipLog <no-reply@example.com>
